<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8">
  <title>Password Reset Requested</title>
</head>

<body style="font-family: Arial, sans-serif; background-color: #f2f4f6; margin: 0; padding: 0;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 40px 0;">
        <table width="600" cellpadding="0" cellspacing="0"
          style="background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">

          <tr>
            <td align="center" style="padding: 30px;">
              <img src="https://sqc-bucket.in-maa-1.linodeobjects.com/Valar%20Logo.png" alt="Valar Commerce Logo" width="120"
                style="margin-bottom: 15px;">
            </td>
          </tr>

          <!-- Seller Details -->
          <tr>
            <td style="padding: 0 30px 10px 30px;">
              <table width="100%" style="font-size: 15px; color: #333;">
                <tr>
                  <td style="vertical-align: middle; white-space: nowrap;"><strong>Hai {{userName}}!</strong></td>
                </tr>
                <tr>
                  <td>We have received your password change request.</td>
                </tr>
                <tr>
                  <td><a href="{{resetLink}}">Click here</a> to reset your password</td>
                </tr>
              </table>
            </td>
          </tr>


          <!-- Custom Message Block -->
          <tr>
            <td style="padding: 10px 30px 20px 30px;">
              <p style="font-size: 15px; color: #333;">
                Best regards,<br>
                <strong>The Valar Commerce Team</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color: #f9f9f9; padding: 20px 30px; text-align: center; border-top: 1px solid #eee;">
              <p style="font-size: 13px; color: #999;">
                Need help? Contact us at <a href="mailto:support@valardigital.in"
                  style="color: #1a73e8;">support@valardigital.in</a>
              </p>
             
              <p style="font-size: 12px; color: #ccc; margin-top: 10px;">
                &copy; 2025 Valar Commerce. All rights reserved.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>

</html>